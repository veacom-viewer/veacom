{
  // oxlint (tools/oxlint.mjs runs the pinned release): its correctness rules, which find code that is wrong or does
  // nothing, plus a few that keep slips out. CI fails on any finding.
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/apps_v1.84.0/npm/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "promise", "node"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-debugger": "error",
    "no-var": "error",
    "typescript/ban-ts-comment": "error",
    "react-hooks/rules-of-hooks": "error",
    // `_name` marks a name kept on purpose; `{ dropped, ...rest }` leaves a field out of a copy.
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none", "ignoreRestSiblings": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    // DICOM, ZIP and PNG parsing matches control characters on purpose.
    "no-control-regex": "off",
    // Reads every handler named `callback` as a Node callback.
    "promise/no-callback-in-promise": "off",
    // Copies made on purpose: a snapshot of listeners that may unsubscribe while called, a typed array as a plain one.
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    // The effect dependencies and state set in effects are left to a review of the viewer's effects; the React Compiler
    // memoizes the rest (tools/check-react-memo.mjs).
    "react-hooks/exhaustive-deps": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    // The renderer reports through the usage log and the app's own messages, not the console.
    { "files": ["src/**"], "rules": { "no-console": ["error", { "allow": ["error", "warn"] }] } },
    // Expected values written as the formula they come from, such as 0 / scale.
    { "files": ["tests/**"], "rules": { "oxc/erasing-op": "off" } },
    // The ROI worker check sets a module variable from its test component.
    { "files": ["tools/verify-roi-worker.tsx"], "rules": { "react/globals": "off" } }
  ]
}
