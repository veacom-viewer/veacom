// viewer.veacom.app: the browser build of VEAcom. Static files from ./public (made by prepare.mjs); every request goes
// through worker.js, which adds the headers the page needs. Only viewer.veacom.app serves it (no workers.dev address).
//   wrangler dev --ip 127.0.0.1 --port 8788     (try it locally)
//   wrangler login                              (once, approves this computer in the Cloudflare account)
//   wrangler deploy
{
  "name": "veacom-viewer",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Every request goes through the Worker first, for the headers.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "viewer.veacom.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
